# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Database -------------------------------------------------------------
POSTGRES_DB=hamgam
POSTGRES_USER=hamgam
POSTGRES_PASSWORD=change-me

# --- Admin page (HTTP basic auth on /admin) --------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- SMS -------------------------------------------------------------------
# console   = print codes to the app log (local development only)
# kavenegar = send real SMS
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
# Name of the verify template created in the Kavenegar panel (its text must contain %token)
KAVENEGAR_OTP_TEMPLATE=

# --- OTP -------------------------------------------------------------------
# Long random string; used to hash codes before they are stored. e.g. `openssl rand -hex 32`
OTP_HMAC_SECRET=change-me
# Codes per phone per day, and per IP address per hour
OTP_PHONE_DAILY_LIMIT=5
OTP_IP_HOURLY_LIMIT=30

# --- Ports published on the host (change only for local testing) -----------
HTTP_PORT=80
HTTPS_PORT=443

# --- Images ----------------------------------------------------------------
# Tag of the app image (useful when you transfer images with docker save / load)
APP_VERSION=latest
# Registry host to pull base images from. Change to a mirror if Docker Hub is blocked.
REGISTRY=docker.io
# Optional Maven repository mirror URL, used only while building the image
MAVEN_MIRROR_URL=
