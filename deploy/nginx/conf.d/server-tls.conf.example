# Copy to server-tls.conf to also serve HTTPS from this server (CDN "full" mode, or no CDN).
# Put the certificate and key in deploy/nginx/certs/ (that folder is git-ignored):
#   deploy/nginx/certs/fullchain.pem
#   deploy/nginx/certs/privkey.pem
# Use the origin certificate issued in your CDN panel, or any certificate you have bought.

listen 443 ssl;
http2 on;
ssl_certificate     /etc/nginx/certs/fullchain.pem;
ssl_certificate_key /etc/nginx/certs/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
